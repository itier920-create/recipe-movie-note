# 本番用の環境変数の見本
# サーバー上でこのファイルをコピーして .env.production を作り、値を入れる（Git には含めない）
# cp .env.production.example .env.production

# MySQL のパスワード（長くてランダムな英数字にする。例：openssl rand -hex 24 で作れる。DATABASE_URL に入るため、/ や + などの記号は使わない）
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""

# Auth.js がログイン情報の cookie を暗号化する鍵（手元とは別の値にする。作り方：openssl rand -base64 32）
AUTH_SECRET=""
# Caddy から転送されてきた URL を信用してよいという設定（Caddy の後ろで動かすため必要）
AUTH_TRUST_HOST=true

# Google ログイン
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# YouTube Data API v3
YOUTUBE_API_KEY=""
