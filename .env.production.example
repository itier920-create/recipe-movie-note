# 本番用の環境変数の見本
# サーバー上でこのファイルをコピーして .env.production を作り、値を入れる（Git には含めない）
# cp .env.production.example .env.production

# MySQL のパスワード（長くてランダムな文字列にする。例：openssl rand -base64 24 で作れる）
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""

# Google ログイン
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# YouTube Data API v3
YOUTUBE_API_KEY=""
