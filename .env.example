# このファイルをコピーして .env を作る（.env は Git に含めない）
# cp .env.example .env

# 手元の MySQL（docker-compose.yml の設定と合わせる）
# allowPublicKeyRetrieval=true：MySQL 8 の再起動直後でも、パスワード確認用の公開鍵を受け取って接続できるようにする
DATABASE_URL="mysql://app:apppassword@localhost:3306/recipe_movie_note?allowPublicKeyRetrieval=true"

# Auth.js がログイン情報の cookie を暗号化する鍵（作り方：openssl rand -base64 32）
AUTH_SECRET=""

# Google ログイン（Google Cloud の「クライアント」で発行した値）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# YouTube Data API v3（Google Cloud の「認証情報」で発行した API キー）
YOUTUBE_API_KEY=""
