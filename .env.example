# このファイルをコピーして .env を作る（.env は Git に含めない）
# cp .env.example .env

# 手元の MySQL（docker-compose.yml の設定と合わせる）
DATABASE_URL="mysql://app:apppassword@localhost:3306/recipe_movie_note"

# Google ログイン（Google Cloud の「クライアント」で発行した値）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# YouTube Data API v3（Google Cloud の「認証情報」で発行した API キー）
YOUTUBE_API_KEY=""
